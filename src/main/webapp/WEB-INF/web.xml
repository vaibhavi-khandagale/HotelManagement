<servlet-name>AddRoomServlet</servlet-name>
<servlet-class>com.hotel.AddRoomServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>AddRoomServlet</servlet-name>
<url-pattern>/AddRoomServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>BookRoomServlet</servlet-name>
<servlet-class>com.hotel.BookRoomServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>BookRoomServlet</servlet-name>
<url-pattern>/BookRoomServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>UpdateRoomServlet</servlet-name>
<servlet-class>com.hotel.UpdateRoomServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>UpdateRoomServlet</servlet-name>
