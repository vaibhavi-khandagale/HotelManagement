<?xml version="1.0" encoding="UTF-8"?>


<web-app>

<display-name>HotelManagement</display-name>
  <welcome-file-list>
    <welcome-file>dashboard.jsp</welcome-file>
    
    </welcome-file-list>
    
<servlet>
