<servlet-class>com.hotel.CheckInServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>CheckInServlet</servlet-name>
<url-pattern>/CheckInServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>CheckOutServlet</servlet-name>
<servlet-class>com.hotel.CheckOutServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>CheckOutServlet</servlet-name>
<url-pattern>/CheckOutServlet</url-pattern>
</servlet-mapping>


</web-app>